# 模型权重：本项目选择「二进制直接入库」（非 git-lfs）。
# 上面的 **/bin/ 只匹配名为 bin 的目录、不会误伤 *.bin 文件；这里再显式放行
# assets/models 下的权重，固化意图，防止将来新增通配规则时把模型漏掉。
!client/app/src/main/assets/models/*.bin
!client/app/src/main/assets/models/*.param
!client/app/src/main/assets/models/*.gguf

# .models/ 是下载下来的「基座」缓存（yolov8s.pt / PP-OCRv4 / bge / rbt3，约 279MB）。
# 入包的是 tools/p1 转换后的产物，那些才入 git；基座可由
# `python tools/p1/check_bases.py --download` 重新获取，不入库。
.models/
.a_plus_plus/
.venv-app/
tmp*

# YOLO local screenshots and datasets
tools/train_yolo/raw/
tools/train_yolo/dataset/
tools/train_yolo/dataset_tiled/
tools/train_yolo/dataset_vis/
tools/train_yolo/templates/

# P2 OCR 跑分的真机原始截图（约 180MB，且是用户本机地图/战报画面）。
# 留档在本地即可：跑分结论与判定闸门已落在 ocr_regression/ 的报告与脚本里，
# 截图本身既不该进仓库也不该对外发布。
tools/ocr_regression/raw/

# 会话期间的临时脚本与输出（探底/调参/自测日志）。
# 这些文件想删也删不掉（工具报成功但仍在磁盘上），很容易被一句 `git add -A`
# 顺手带进仓库，所以直接按命名习惯屏蔽：
#   * 根目录下任何以下划线开头的名字——本会话所有 scratch 都用这个前缀
#   * 上一轮留在根目录的探底产物（p3run / probe* / tune*）
# 它们都只服务于一次性验证，产物本身不是交付物。
/_*
/p3run.txt
/probe[0-9]*
/tune[0-9]*
# 本轮会话的临时脚本/输出用的是 scratch_ 前缀，不是下划线前缀——
# 上一条规则盖不住它们，而它们同样只是一次性验证的产物。
/scratch_*

# 发布台账是「本机已经对外发过哪一版」的运行状态，不是数据源头。
# 不进仓库：共享一份台账会让另一台机器上的正常发布被版本单调闸门误杀。
pipeline/publish_ledger.json

# 用户提供的**真机截图批次**（tools/p3/<批次号>/，本轮 21 张 2712x1220 约 38MB）。
# 场景指纹与模板匹配两项实测靠它跑，但截图本身是玩家本机画面（含玩家名、坐标、
# 资源数值），既不应当进仓库、也不该对外发布；跑完留在本地即可，
# 需要复跑时用 --map/--other 或 STZB_FP_MAP/STZB_FP_OTHER 指路径。
# 只屏蔽子目录，p3 下的校验脚本（*.py）照常入库。
tools/p3/*/
tools/p3/_*
tools/p3/*_index.txt
