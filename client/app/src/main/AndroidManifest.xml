<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 悬浮窗与前台服务权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 触控与夜战震动警报权限 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      系统硬件级 RTC 精确定时唤醒权限（离线战术定时管家的核心依赖）。

      为什么必须声明：`ScheduledTaskManager.syncNextExactAlarm()` 调用的是
      `AlarmManager.setExactAndAllowWhileIdle()`。自 Android 12 (API 31) 起，
      该调用**必须**持有 SCHEDULE_EXACT_ALARM，否则直接抛 SecurityException——
      此前本清单漏了这一条，异常被 catch 静默吞掉，"硬件级 RTC 唤醒"实际退化成
      15 秒协程轮询，深度息屏（Doze）后定时任务根本不会准点触发。

      targetSdk 34 下该权限不会被自动授予，需要在运行时引导用户到
      「设置 → 应用 → 特殊应用权限 → 闹钟与提醒」手动开启
      （见 ScheduledTaskManager.needsExactAlarmPermission / openExactAlarmSettings）。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      开机重建定时闹钟权限。
      系统重启会清空所有 AlarmManager 精确闹钟，必须在 BOOT_COMPLETED 时把
      持久化的定时计划重新登记回硬件 RTC，否则“离线战术定时管家”一重启就静默失效。
      （见 BootCompletedReceiver / ScheduledTaskManager.restoreAlarmsAfterBoot）
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="率土全能管家"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.StzbAssistant">

        <!-- 主控管理控制台 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 720p 屏幕捕获前台服务 (必须严格标注 foregroundServiceType=mediaProjection) -->
        <service
            android:name=".service.ScreenCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 拟人化无障碍触控通道服务 -->
        <service
            android:name=".service.AutoTouchService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 常驻悬浮窗胶囊服务 -->
        <service
            android:name=".service.FloatOverlayService"
            android:enabled="true"
            android:exported="false" />

        <!-- 系统硬件级 RTC 闹钟精准唤醒广播接收器 (零外部依赖，深度息屏保活) -->
        <receiver
            android:name=".tactics.ScheduledTaskManager$ScheduledTaskAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          开机自启重建接收器：系统重启后重新登记定时管家的硬件 RTC 闹钟。
          BOOT_COMPLETED 由系统发出，必须 exported=true 才能收到（targetSdk 34 要求显式声明）。
        -->
        <receiver
            android:name=".tactics.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
