<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题栏 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="本地离线视觉引擎 · 拟人自动化辅助"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 运行环境 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:text="运行环境" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="按顺序逐项授权即可；点击任意一项直达系统设置，开启后自动变为绿色"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayPermission"
                style="@style/Btn.Permission"
                android:text="1. 授予悬浮窗权限" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccessibilityPermission"
                style="@style/Btn.Permission"
                android:text="2. 开启无障碍服务通道" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleOverlay"
                style="@style/Btn.Permission"
                android:text="3. 显示游戏悬浮胶囊" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScreenCapturePermission"
                style="@style/Btn.Permission"
                android:text="4. 启动屏幕捕获" />

            <!-- 文字识别（OCR）状态
                 为什么必须摆在主界面上：默认构建里 native OCR 是空桩，
                 而在此之前主界面**完全不显示**这一点——用户只能等某个战术流程
                 莫名失败才发现"识别根本不存在"。这是一项"让缺失可见"的改动。 -->
            <TextView
                android:id="@+id/tvOcrStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="文字识别（OCR）：状态读取中…"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOcrDiagnostics"
                style="@style/Btn.Chip"
                android:layout_marginTop="8dp"
                android:text="查看识别环境详情" />
        </LinearLayout>

        <!-- 游戏知识库 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvKnowledgeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="游戏知识库"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKnowledgeVersionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="v—"
                    android:textColor="@color/success"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvKnowledgeStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="规则数据加载中…"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchGame"
                    style="@style/Btn.Chip"
                    android:text="切换游戏" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateKnowledge"
                    style="@style/Btn.Chip"
                    android:layout_marginStart="8dp"
                    android:text="检查更新" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewLandGuide"
                    style="@style/Btn.Chip"
                    android:layout_marginStart="8dp"
                    android:text="打地指南" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvKnowledgeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="支持离线运行"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 授权与激活 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:text="授权与激活" />

            <TextView
                android:id="@+id/tvLicenseStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="授权状态读取中…"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActivateLicense"
                    style="@style/Btn.Chip"
                    android:text="输入卡密激活" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetLicense"
                    style="@style/Btn.Chip"
                    android:layout_marginStart="8dp"
                    android:text="重置授权" />
            </LinearLayout>
        </LinearLayout>

        <!-- 状态提示（轻量） -->
        <TextView
            android:id="@+id/tvLogOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="monospace"
            android:maxLines="6"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:text="系统就绪。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
