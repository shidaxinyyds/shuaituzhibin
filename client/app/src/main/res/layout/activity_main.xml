<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题栏 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="本地离线视觉引擎 · 拟人自动化辅助"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 运行环境 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:text="运行环境" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayPermission"
                style="@style/Btn.Secondary"
                android:text="1. 授予悬浮窗权限" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccessibilityPermission"
                style="@style/Btn.Secondary"
                android:text="2. 开启无障碍触控通道" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScreenCapturePermission"
                style="@style/Btn.Secondary"
                android:text="3. 启动屏幕捕获" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleOverlay"
                style="@style/Btn.Primary"
                android:text="4. 显示游戏悬浮胶囊" />
        </LinearLayout>

        <!-- 战术调度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:text="战术调度" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartRoadPaving"
                style="@style/Btn.Secondary"
                android:text="自动铺路翻地" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartImmunityBreak"
                style="@style/Btn.Secondary"
                android:text="极限卡免破免" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartSiegeSync"
                style="@style/Btn.Secondary"
                android:text="同盟集火攻城" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartRaidDefense"
                style="@style/Btn.Secondary"
                android:text="深夜敌袭巡检反击" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopAllTactics"
                style="@style/Btn.Danger"
                android:text="紧急停止全部任务" />
        </LinearLayout>

        <!-- 游戏知识库 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvKnowledgeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="游戏知识库"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKnowledgeVersionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="v—"
                    android:textColor="@color/success"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvKnowledgeStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="规则数据加载中…"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchGame"
                    style="@style/Btn.Chip"
                    android:text="切换游戏" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateKnowledge"
                    style="@style/Btn.Chip"
                    android:layout_marginStart="8dp"
                    android:text="检查更新" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewLandGuide"
                    style="@style/Btn.Chip"
                    android:layout_marginStart="8dp"
                    android:text="打地指南" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvKnowledgeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="支持离线运行"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 开发者自检（默认折叠，隐藏调试内容） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleDebug"
            style="@style/Btn.Secondary"
            android:layout_marginTop="14dp"
            android:text="开发者自检工具  ▾" />

        <LinearLayout
            android:id="@+id/debugSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestOcr" style="@style/Btn.Secondary" android:layout_height="44dp" android:text="A · OCR 推理与守军打分" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestCaptureTouch" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="B · 自适应画布与贝塞尔触控" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestSceneMatch" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="C · 场景识别与语义按键" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestRaidRadar" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="D · 敌袭雷达与源头回溯" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestTileImmunity" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="E · 免战罩与卡免倒计时" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestTroopTiming" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="F · 部队士气与攻城卡秒" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestTimingFingerprint" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="G · 时间指纹与昼夜节律" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestKineticTouch" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="H · 高斯微抖与惯性轨迹" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestStealthAudit" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="I · 反嗅探环境审计" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestCapsuleOverlay" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="J · 悬浮胶囊与控制台" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestCrosshairPicker" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="K · 准星坐标拾取器" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestYoloVision" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="L · YOLO 目标检测" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestSlmDecree" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="M · 军令因果推理" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestSlmDiagnosis" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="N · 战报深度会诊" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestSafetyGate" style="@style/Btn.Secondary" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="O · 双轨决策安全闸门" />

            <TextView
                android:id="@+id/tvLogOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill"
                android:fontFamily="monospace"
                android:maxLines="18"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:text="系统就绪。"
                android:textColor="@color/success"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
