<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#44000000">

    <!-- 顶部准星取点说明条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC1A237E"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvPickerHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎯 准星坐标嗅探模式：请直接轻点游戏屏幕上的目标地块或城池"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelPicker"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="#55FFFFFF"
            android:text="取消返回"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 准星十字环指示器 -->
    <FrameLayout
        android:id="@+id/flCrosshairContainer"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_crosshair"
        android:visibility="gone">

        <!-- 中心十字微光点 -->
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="#00E676" />
    </FrameLayout>

</FrameLayout>
