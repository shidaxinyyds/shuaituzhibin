<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/capsuleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_capsule"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- 状态指示灯点 (绿色就绪 / 蓝色执行 / 黄色卡秒 / 红色警报) -->
    <View
        android:id="@+id/vStatusIndicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="#00E676" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCapsuleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="率土管家"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCapsuleSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="待命 · 点击展开控制台"
            android:textColor="#B0BEC5"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
