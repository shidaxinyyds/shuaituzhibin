<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboardRoot"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dashboard"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 顶部标题栏（按住可拖动面板）与关闭按键 -->
    <LinearLayout
        android:id="@+id/dashboardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="26dp"
            android:layout_height="4dp"
            android:layout_marginEnd="10dp"
            android:background="#55FFFFFF" />

        <TextView
            android:id="@+id/tvDashboardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="战术总控"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCloseDashboard"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 战术功能 Tab 切换栏 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabPaving"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="铺路"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabImmunity"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="卡免"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabSiege"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="攻城"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabPatrol"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="巡检"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabLogs"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="日志"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabAdvisor"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="军师"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 容器内容区 (根据 Tab 动态切换可见性) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <!-- 1. 铺路面板 -->
        <LinearLayout
            android:id="@+id/panelPaving"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvPavingCoord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="目标地块：尚未点选"
                android:textColor="#90CAF9"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPickPavingTile"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:text="点选目标地块"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnExecPaving"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_primary"
                android:text="开始铺路翻地"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 2. 卡免面板 -->
        <LinearLayout
            android:id="@+id/panelImmunity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvImmunityCoord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="卡免地块：尚未选择"
                android:textColor="#FFE082"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPickImmunityTile"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:text="点选免战地块"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnExecBreakImmunity"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_primary"
                android:text="启动压秒破免"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 3. 攻城面板 -->
        <LinearLayout
            android:id="@+id/panelSiege"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSiegeCoord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="集火城池：尚未点选"
                android:textColor="#CE93D8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPickSiegeCity"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:text="点选目标城池"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnExecSiegeSync"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_primary"
                android:text="启动集火攻城"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 4. 敌袭巡检面板 -->
        <LinearLayout
            android:id="@+id/panelPatrol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="全天候红线巡检与自动断路反击"
                android:textColor="#EF9A9A"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnExecRaidPatrol"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_danger"
                android:text="开启敌袭巡检与反击"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 5. 日志面板 -->
        <LinearLayout
            android:id="@+id/panelLogs"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/bg_pill"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/scrollInGameLogs"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvInGameLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="日志就绪…"
                    android:textColor="#81C784"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>

        <!-- 6. 军师思考流面板 -->
        <LinearLayout
            android:id="@+id/panelAdvisor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="军师 · 端侧认知推理"
                android:textColor="#80D8FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdvisorMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="状态：待命"
                android:textColor="#90A4AE"
                android:textSize="11sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvAdvisorStream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="正在感知战场动态…"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAdvisorScanDecree"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:text="识别军令"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnAdvisorDiagnose"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:text="战报会诊"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAdvisorAutoExec"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_primary"
                android:text="核验并自动执行"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </FrameLayout>

    <!-- 急停按钮 -->
    <Button
        android:id="@+id/btnEmergencyStop"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_danger"
        android:text="紧急停止当前任务"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

</LinearLayout>
